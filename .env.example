# Shubh Milk — environment variables
# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored — your keys never reach the repository.

# ─── Razorpay payment gateway (optional) ────────────────────────────────────
# Create a free account at https://dashboard.razorpay.com → Settings → API Keys.
# Leave everything empty to keep the site in "stub" checkout mode (no real
# payments — good while developing; see docs/PAYMENTS.md).
#
#   Test keys    — start with these. Money is never taken; use Razorpay's
#                  test cards/UPI to see the full flow.
#   Live keys    — only after testing. Real money moves.
#
# All three values come from the SAME key pair (test pair together, or live
# pair together — never mix).

# Server-side secret. NEVER expose this to the browser.
RAZORPAY_KEY_SECRET=

# The public key id. Used server-side to create orders.
RAZORPAY_KEY_ID=

# Same key id as above, exposed to the browser to open the payment sheet.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
